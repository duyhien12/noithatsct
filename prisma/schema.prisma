// ═══════════════════════════════════════════════════════════════════════
// MODULE QUẢN LÝ SẢN XUẤT XƯỞNG (Manufacturing) — tiền tố Mfg/Quality/Packing/Delivery
// Tách biệt hoàn toàn với ProductionOrder/ProductionPlan cũ (đang có dữ liệu thật ở /production).
// Trạng thái lưu dạng String (theo convention toàn schema, không dùng Prisma enum):
// MfgOrder.status: DRAFT, WAITING_DOCUMENTS, WAITING_APPROVAL, WAITING_MATERIALS, READY,
//   IN_PRODUCTION, WAITING_QC, REWORK, COMPLETED_AT_FACTORY, PACKED, DELIVERED, INSTALLING,
//   COMPLETED, PAUSED, CANCELLED
// MfgItem.status: NOT_STARTED, WAITING_DRAWING, WAITING_MATERIAL, READY, IN_PROGRESS,
//   WAITING_QC, REWORK, PASSED_QC, PACKED, DELIVERED, INSTALLED, COMPLETED, PAUSED, CANCELLED
// MfgItemStage.status / MfgTask.status: NOT_STARTED, READY, IN_PROGRESS, PAUSED, BLOCKED,
//   WAITING_APPROVAL, COMPLETED, FAILED, CANCELLED
// ═══════════════════════════════════════════════════════════════════════

model MfgOrder {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  projectId           String
  contractId          String?
  title               String
  description         String                   @default("")
  batchNumber         String                   @default("")
  priority            String                   @default("NORMAL")
  status              String                   @default("DRAFT")
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  progressPercent     Int                      @default(0)
  productionManagerId String                   @default("")
  qcManagerId         String                   @default("")
  approvedById        String                   @default("")
  approvedAt          DateTime?
  note                String                   @default("")
  cancelReason        String                   @default("")
  createdById         String                   @default("")
  updatedById         String                   @default("")
  deletedAt           DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  project             Project                  @relation(fields: [projectId], references: [id])
  contract            Contract?                @relation(fields: [contractId], references: [id])
  items               MfgItem[]
  tasks               MfgTask[]
  logs                MfgLog[]
  materialReqs        MfgMaterialRequirement[]
  qualityInspections  QualityInspection[]
  qualityIssues       QualityIssue[]
  packingRecords      PackingRecord[]
  deliveryRecords     DeliveryRecord[]

  @@index([projectId])
  @@index([status])
  @@index([plannedEndDate])
}

model MfgItem {
  id                  String                   @id @default(cuid())
  code                String                   @unique
  mfgOrderId          String
  projectId           String
  name                String
  category            String                   @default("")
  floorName           String                   @default("")
  roomName            String                   @default("")
  quantity            Float                    @default(1)
  unit                String                   @default("cái")
  length              Float                    @default(0)
  width               Float                    @default(0)
  height              Float                    @default(0)
  materialDescription String                   @default("")
  colorDescription    String                   @default("")
  hardwareDescription String                   @default("")
  drawingDocumentId   String?
  drawingUrl          String                   @default("")
  referenceImageUrl   String                   @default("")
  status              String                   @default("NOT_STARTED")
  progressPercent     Int                      @default(0)
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  actualStartDate     DateTime?
  actualEndDate       DateTime?
  assignedTeamName    String                   @default("")
  assignedWorkerId    String?
  priority            String                   @default("NORMAL")
  note                String                   @default("")
  createdById         String                   @default("")
  updatedById         String                   @default("")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  mfgOrder            MfgOrder                 @relation(fields: [mfgOrderId], references: [id])
  project             Project                  @relation(fields: [projectId], references: [id])
  drawingDoc          ProjectDocument?         @relation(fields: [drawingDocumentId], references: [id])
  assignedWorker      WorkshopWorker?          @relation(fields: [assignedWorkerId], references: [id])
  stages              MfgItemStage[]
  tasks               MfgTask[]
  logs                MfgLog[]
  materialReqs        MfgMaterialRequirement[]
  qualityInspections  QualityInspection[]
  qualityIssues       QualityIssue[]
  packingItems        PackingItem[]
  deliveryItems       DeliveryItem[]

  @@index([mfgOrderId])
  @@index([projectId])
  @@index([status])
  @@index([assignedWorkerId])
}

model MfgStageTemplate {
  id                   String         @id @default(cuid())
  code                 String         @unique
  name                 String
  description          String         @default("")
  sequence             Int            @default(0)
  productCategory      String         @default("")
  defaultDurationHours Float          @default(0)
  isRequired           Boolean        @default(true)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  itemStages           MfgItemStage[]

  @@index([sequence])
}

model MfgItemStage {
  id               String            @id @default(cuid())
  mfgItemId        String
  stageTemplateId  String?
  name             String
  sequence         Int               @default(0)
  status           String            @default("NOT_STARTED")
  progressPercent  Int               @default(0)
  assignedTeamName String            @default("")
  assignedWorkerId String?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  estimatedHours   Float             @default(0)
  actualHours      Float             @default(0)
  note             String            @default("")
  completedById    String            @default("")
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  item             MfgItem           @relation(fields: [mfgItemId], references: [id], onDelete: Cascade)
  stageTemplate    MfgStageTemplate? @relation(fields: [stageTemplateId], references: [id])
  assignedWorker   WorkshopWorker?   @relation(fields: [assignedWorkerId], references: [id])
  tasks            MfgTask[]
  logs             MfgLog[]
  qualityIssues    QualityIssue[]

  @@index([mfgItemId])
  @@index([status])
  @@index([assignedWorkerId])
}

model MfgTask {
  id               String          @id @default(cuid())
  code             String          @unique
  mfgOrderId       String
  mfgItemId        String?
  mfgItemStageId   String?
  title            String
  description      String          @default("")
  assignedTeamName String          @default("")
  assignedWorkerId String?
  assignedById     String          @default("")
  priority         String          @default("NORMAL")
  status           String          @default("NOT_STARTED")
  plannedStartDate DateTime?
  dueDate          DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  estimatedHours   Float           @default(0)
  actualHours      Float           @default(0)
  progressPercent  Int             @default(0)
  note             String          @default("")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  mfgOrder         MfgOrder        @relation(fields: [mfgOrderId], references: [id])
  item             MfgItem?        @relation(fields: [mfgItemId], references: [id])
  itemStage        MfgItemStage?   @relation(fields: [mfgItemStageId], references: [id])
  assignedWorker   WorkshopWorker? @relation(fields: [assignedWorkerId], references: [id])
  logs             MfgLog[]

  @@index([mfgOrderId])
  @@index([mfgItemId])
  @@index([assignedWorkerId])
  @@index([dueDate])
  @@index([status])
}

model MfgLog {
  id                String          @id @default(cuid())
  mfgOrderId        String
  mfgItemId         String?
  mfgItemStageId    String?
  taskId            String?
  logDate           DateTime        @default(now())
  workerId          String?
  teamName          String          @default("")
  workDescription   String          @default("")
  completedQuantity Float           @default(0)
  workHours         Float           @default(0)
  progressBefore    Int             @default(0)
  progressAfter     Int             @default(0)
  issueDescription  String          @default("")
  nextPlan          String          @default("")
  createdById       String          @default("")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  mfgOrder          MfgOrder        @relation(fields: [mfgOrderId], references: [id])
  item              MfgItem?        @relation(fields: [mfgItemId], references: [id])
  itemStage         MfgItemStage?   @relation(fields: [mfgItemStageId], references: [id])
  task              MfgTask?        @relation(fields: [taskId], references: [id])
  worker            WorkshopWorker? @relation(fields: [workerId], references: [id])

  @@index([mfgOrderId])
  @@index([mfgItemId])
  @@index([logDate])
}

model MfgMaterialRequirement {
  id                 String    @id @default(cuid())
  mfgOrderId         String
  mfgItemId          String?
  productId          String?
  materialName       String    @default("")
  specification      String    @default("")
  unit               String    @default("")
  estimatedQuantity  Float     @default(0)
  issuedQuantity     Float     @default(0)
  usedQuantity       Float     @default(0)
  returnedQuantity   Float     @default(0)
  missingQuantity    Float     @default(0)
  estimatedUnitPrice Float     @default(0)
  actualUnitPrice    Float     @default(0)
  status             String    @default("NOT_REQUESTED")
  requiredDate       DateTime?
  note               String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mfgOrder           MfgOrder  @relation(fields: [mfgOrderId], references: [id])
  item               MfgItem?  @relation(fields: [mfgItemId], references: [id])
  product            Product?  @relation(fields: [productId], references: [id])

  @@index([mfgOrderId])
  @@index([mfgItemId])
  @@index([status])
}

model QualityInspection {
  id                String         @id @default(cuid())
  code              String         @unique
  mfgOrderId        String
  mfgItemId         String?
  inspectionType    String         @default("IN_PROCESS")
  inspectorId       String         @default("")
  inspectedAt       DateTime       @default(now())
  result            String         @default("PASSED")
  dimensionPassed   Boolean        @default(true)
  materialPassed    Boolean        @default(true)
  colorPassed       Boolean        @default(true)
  hardwarePassed    Boolean        @default(true)
  surfacePassed     Boolean        @default(true)
  edgePassed        Boolean        @default(true)
  structurePassed   Boolean        @default(true)
  assemblyPassed    Boolean        @default(true)
  cleanlinessPassed Boolean        @default(true)
  packingPassed     Boolean        @default(true)
  overallNote       String         @default("")
  approvedById      String         @default("")
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  mfgOrder          MfgOrder       @relation(fields: [mfgOrderId], references: [id])
  item              MfgItem?       @relation(fields: [mfgItemId], references: [id])
  issues            QualityIssue[]

  @@index([mfgOrderId])
  @@index([mfgItemId])
  @@index([result])
}

model QualityIssue {
  id                  String             @id @default(cuid())
  code                String             @unique
  mfgOrderId          String
  mfgItemId           String?
  mfgItemStageId      String?
  qualityInspectionId String?
  title               String
  description         String             @default("")
  severity            String             @default("NORMAL")
  causeType           String             @default("")
  responsibleTeamName String             @default("")
  responsibleWorkerId String?
  reportedById        String             @default("")
  reportedAt          DateTime           @default(now())
  dueDate             DateTime?
  status              String             @default("OPEN")
  correctiveAction    String             @default("")
  repairCost          Float              @default(0)
  resolvedById        String             @default("")
  resolvedAt          DateTime?
  verifiedById        String             @default("")
  verifiedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  mfgOrder            MfgOrder           @relation(fields: [mfgOrderId], references: [id])
  item                MfgItem?           @relation(fields: [mfgItemId], references: [id])
  itemStage           MfgItemStage?      @relation(fields: [mfgItemStageId], references: [id])
  inspection          QualityInspection? @relation(fields: [qualityInspectionId], references: [id])
  responsibleWorker   WorkshopWorker?    @relation(fields: [responsibleWorkerId], references: [id])

  @@index([mfgOrderId])
  @@index([mfgItemId])
  @@index([status])
  @@index([dueDate])
  @@index([severity])
}

model PackingRecord {
  id            String         @id @default(cuid())
  code          String         @unique
  mfgOrderId    String
  packageNumber String         @default("")
  packageType   String         @default("")
  quantity      Int            @default(1)
  packedById    String         @default("")
  packedAt      DateTime       @default(now())
  status        String         @default("PACKED")
  labelCode     String         @default("")
  qrCodeValue   String         @default("")
  note          String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mfgOrder      MfgOrder       @relation(fields: [mfgOrderId], references: [id])
  items         PackingItem[]
  deliveryItems DeliveryItem[]

  @@index([mfgOrderId])
}

model PackingItem {
  id              String        @id @default(cuid())
  packingRecordId String
  mfgItemId       String
  quantity        Float         @default(1)
  packingRecord   PackingRecord @relation(fields: [packingRecordId], references: [id], onDelete: Cascade)
  item            MfgItem       @relation(fields: [mfgItemId], references: [id])

  @@index([packingRecordId])
  @@index([mfgItemId])
}

model DeliveryRecord {
  id                   String         @id @default(cuid())
  code                 String         @unique
  mfgOrderId           String
  projectId            String
  deliveryDate         DateTime       @default(now())
  vehicleNumber        String         @default("")
  driverName           String         @default("")
  driverPhone          String         @default("")
  carrierName          String         @default("")
  deliveryContactName  String         @default("")
  deliveryContactPhone String         @default("")
  status               String         @default("PLANNED")
  departedAt           DateTime?
  arrivedAt            DateTime?
  receivedBy           String         @default("")
  receivedAt           DateTime?
  note                 String         @default("")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  mfgOrder             MfgOrder       @relation(fields: [mfgOrderId], references: [id])
  project              Project        @relation(fields: [projectId], references: [id])
  items                DeliveryItem[]

  @@index([mfgOrderId])
  @@index([projectId])
}

model DeliveryItem {
  id               String         @id @default(cuid())
  deliveryRecordId String
  packingRecordId  String?
  mfgItemId        String?
  quantity         Float          @default(1)
  deliveryRecord   DeliveryRecord @relation(fields: [deliveryRecordId], references: [id], onDelete: Cascade)
  packingRecord    PackingRecord? @relation(fields: [packingRecordId], references: [id])
  item             MfgItem?       @relation(fields: [mfgItemId], references: [id])

  @@index([deliveryRecordId])
  @@index([packingRecordId])
  @@index([mfgItemId])
}

// Đính kèm dùng chung (ảnh/PDF/bản vẽ) cho toàn bộ entity của module sản xuất —
// tránh nhân bản 8 bảng đính kèm riêng cho từng entity (Order/Item/Stage/Log/QC/Issue/Packing/Delivery).
model MfgAttachment {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  url            String
  thumbnailUrl   String   @default("")
  fileName       String   @default("")
  mimeType       String   @default("")
  caption        String   @default("")
  photoStage     String   @default("")
  uploadedById   String   @default("")
  uploadedByName String   @default("")
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
}

// Audit log dùng chung cho các thao tác quan trọng: duyệt lệnh, đổi trạng thái, QC, hủy lệnh, xuất xưởng...
model MfgAuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  fromStatus String   @default("")
  toStatus   String   @default("")
  byUserId   String   @default("")
  byUserName String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// NHẬT KÝ THU – CHI — sổ thu/chi hàng ngày cho Kế toán tổng hợp
// ============================================================

model BankAccount {
  id              String                @id @default(cuid())
  bankName        String
  accountNumber   String                @default("")
  accountHolder   String                @default("")
  branch          String                @default("")
  status          Boolean               @default(true)
  openingBalance  Float                 @default(0)
  notes           String                @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  transactions    FinanceTransaction[]
  reconciliations CashReconciliation[]
}

model CashFund {
  id              String                @id @default(cuid())
  name            String
  status          Boolean               @default(true)
  openingBalance  Float                 @default(0)
  notes           String                @default("")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  transactions    FinanceTransaction[]
  reconciliations CashReconciliation[]
}

model AccountingAccount {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  active        Boolean              @default(true)
  order         Int                  @default(0)
  createdAt     DateTime             @default(now())
  debitEntries  FinanceTransaction[] @relation("DebitAccount")
  creditEntries FinanceTransaction[] @relation("CreditAccount")
}

model FinanceCategory {
  id           String               @id @default(cuid())
  name         String
  group        String               @default("Chi") // "Thu" | "Chi"
  parentId     String?
  level        Int                  @default(1) // 1 = Nhóm cấp 1, 2 = cấp 2, 3 = cấp 3
  order        Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  parent       FinanceCategory?     @relation("CategoryTree", fields: [parentId], references: [id])
  children     FinanceCategory[]    @relation("CategoryTree")
  transactions FinanceTransaction[]

  @@index([group])
  @@index([parentId])
}

model FinanceTransaction {
  id              String                    @id @default(cuid())
  code            String                    @unique
  date            DateTime
  type            String // "Thu" | "Chi"
  method          String // "Tiền mặt" | "Chuyển khoản"
  amount          Float
  cashIn          Float                     @default(0)
  cashOut         Float                     @default(0)
  bankIn          Float                     @default(0)
  bankOut         Float                     @default(0)
  department      String
  projectId       String?
  splitGroupId    String?
  content         String
  detail          String                    @default("")
  debitAccountId  String
  creditAccountId String
  bankAccountId   String?
  cashFundId      String?
  categoryId      String?
  objectType      String                    @default("")
  objectId        String                    @default("")
  objectName      String                    @default("")
  payerReceiver   String                    @default("")
  itemName        String                    @default("")
  itemUnit        String                    @default("")
  itemQty         Float                     @default(0)
  itemUnitPrice   Float                     @default(0)
  itemAmount      Float                     @default(0)
  documentNo      String                    @default("")
  documentDate    DateTime?
  attachments     Json?                     @default("[]")
  notes           String                    @default("")
  status          String                    @default("Nháp") // Nháp | Đã duyệt | Đã hạch toán | Hủy
  cancelReason    String                    @default("")
  canceledBy      String                    @default("")
  canceledAt      DateTime?
  createdBy       String                    @default("")
  createdById     String                    @default("")
  createdByRole   String                    @default("")
  deletedAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  project         Project?                  @relation(fields: [projectId], references: [id])
  debitAccount    AccountingAccount         @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   AccountingAccount         @relation("CreditAccount", fields: [creditAccountId], references: [id])
  bankAccount     BankAccount?              @relation(fields: [bankAccountId], references: [id])
  cashFund        CashFund?                 @relation(fields: [cashFundId], references: [id])
  category        FinanceCategory?          @relation(fields: [categoryId], references: [id])
  audits          FinanceTransactionAudit[]

  @@index([date])
  @@index([projectId])
  @@index([splitGroupId])
  @@index([department])
  @@index([status])
  @@index([type])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([bankAccountId])
  @@index([cashFundId])
  @@index([categoryId])
}

model FinanceTransactionAudit {
  id            String             @id @default(cuid())
  transactionId String
  action        String // create | update | cancel
  actorName     String             @default("")
  actorId       String             @default("")
  actorRole     String             @default("")
  beforeData    Json?
  afterData     Json?
  reason        String             @default("")
  createdAt     DateTime           @default(now())
  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model CashReconciliation {
  id            String       @id @default(cuid())
  date          DateTime     @default(now())
  targetType    String // "cash" | "bank"
  bankAccountId String?
  cashFundId    String?
  systemBalance Float        @default(0)
  actualBalance Float        @default(0)
  difference    Float        @default(0)
  note          String       @default("")
  reconciledBy  String       @default("")
  createdAt     DateTime     @default(now())
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  cashFund      CashFund?    @relation(fields: [cashFundId], references: [id])

  @@index([targetType])
  @@index([bankAccountId])
  @@index([cashFundId])
}
