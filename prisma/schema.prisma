  stage       ProductionPlanStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

model MaintenanceRecord {
  id               String    @id @default(cuid())
  code             String    @unique
  title            String
  type             String    @default("Bảo hành")
  category         String    @default("Khác")
  priority         String    @default("Trung bình")
  status           String    @default("Tiếp nhận")
  description      String    @default("")
  resolution       String    @default("")
  rootCause        String    @default("")
  notes            String    @default("")
  assignee         String    @default("")
  reportedBy       String    @default("")
  receivedAt       DateTime  @default(now())
  scheduledDate    DateTime?
  startedAt        DateTime?
  completedDate    DateTime?
  slaDeadline      DateTime?
  nextScheduleDate DateTime?
  warrantyEndDate  DateTime?
  isUnderWarranty  Boolean   @default(true)
  isRepeatIssue    Boolean   @default(false)
  repeatCount      Int       @default(0)
  parentIssueId    String?
  estimatedCost    Float     @default(0)
  actualCost       Float     @default(0)
  beforePhotos     String    @default("[]")
  afterPhotos      String    @default("[]")
  customerRating   Int?
  customerFeedback String    @default("")
  ratedAt          DateTime?
  projectId        String
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([slaDeadline])
  @@index([parentIssueId])
}

model ProjectCheckIn {
  id        String   @id @default(cuid())
  type      String   @default("check_in")
  userName  String   @default("")
  lat       Float?
  lng       Float?
  address   String   @default("")
  notes     String   @default("")
  projectId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model CostAllocation {
  id            String   @id
  costProjectId String
  month         String
  basis         String   @default("Theo m²")
  qty           Float    @default(0)
  unitPrice     Float    @default(0)
  type          String   @default("Chi phí xưởng")
  amount        Float    @default(0)
  note          String   @default("")
  createdAt     DateTime @default(now())

  @@index([costProjectId], map: "idx_call_cpid")
}

model CostLabor {
  id            String   @id
  costProjectId String
  category      String   @default("")
  type          String   @default("")
  unit          String   @default("")
  qty           Float    @default(0)
  unitPrice     Float    @default(0)
  amount        Float    @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([costProjectId], map: "idx_clab_cpid")
}

model CostMachine {
  id                  String   @id
  name                String   @default("")
  startDate           String?
  originalCost        Float    @default(0)
  depreciationYears   Float    @default(5)
  monthlyDepreciation Float    @default(0)
  note                String   @default("")
  status              String   @default("Đang dùng")
  createdAt           DateTime @default(now())
}

model CostMaterial {
  id            String   @id
  costProjectId String
  grp           String   @default("")
  name          String   @default("")
  detail        String   @default("")
  unit          String   @default("")
  qty           Float    @default(0)
  unitPrice     Float    @default(0)
  wastePct      Float    @default(0)
  amount        Float    @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([costProjectId], map: "idx_cmat_cpid")
}

model CostMonthly {
  id                  String   @id
  month               String
  electric            Float    @default(0)
  water               Float    @default(0)
  rent                Float    @default(0)
  management          Float    @default(0)
  maintenance         Float    @default(0)
  tools               Float    @default(0)
  other               Float    @default(0)
  machineDepreciation Float    @default(0)
  totalCost           Float    @default(0)
  capacitySqm         Float    @default(800)
  machineHours        Float    @default(160)
  createdAt           DateTime @default(now())
}

model CostOther {
  id            String   @id
  costProjectId String
  name          String   @default("")
  unit          String   @default("")
  qty           Float    @default(0)
  unitPrice     Float    @default(0)
  amount        Float    @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([costProjectId], map: "idx_coth_cpid")
}

model CostProject {
  id            String   @id
  projectId     String?
  code          String   @default("")
  name          String   @default("")
  client        String   @default("")
  signDate      String?
  revenue       Float    @default(0)
  vatPct        Float    @default(0.08)
  commissionPct Float    @default(0.05)
  mgmtPct       Float    @default(0.04)
  status        String   @default("Báo giá")
  notes         String   @default("")
  createdAt     DateTime @default(now())
}

model CostSettings {
  id              String   @id
  vatPct          Float    @default(0.08)
  targetProfitPct Float    @default(0.18)
  commissionPct   Float    @default(0.05)
  mgmtPct         Float    @default(0.04)
  updatedAt       DateTime @default(now())
}

model ContractProcess {
  id         String                @id @default(cuid())
  code       String                @unique
  name       String                @default("")
  type       String
  status     String                @default("Đang thực hiện")
  progress   Int                   @default(0)
  startDate  DateTime?
  endDate    DateTime?
  notes      String                @default("")
  createdBy  String                @default("")
  deletedAt  DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  customerId String
  contractId String?
  contract   Contract?             @relation(fields: [contractId], references: [id])
  customer   Customer              @relation(fields: [customerId], references: [id])
  steps      ContractProcessStep[]

  @@index([customerId])
  @@index([contractId])
}

model ContractProcessStep {
  id             String                @id @default(cuid())
  processId      String
  parentId       String?
  wbs            String                @default("")
  name           String
  assignee       String                @default("")
  department     String                @default("")
  startDate      DateTime?
  endDate        DateTime?
  duration       Int                   @default(1)
  progress       Int                   @default(0)
  status         String                @default("Chưa bắt đầu")
  notes          String                @default("")
  files          String                @default("[]")
  sortOrder      Int                   @default(0)
  level          Int                   @default(0)
  isPaymentStep  Boolean               @default(false)
  paymentPercent Float                 @default(0)
  color          String                @default("")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  parent         ContractProcessStep?  @relation("CPStepTree", fields: [parentId], references: [id])
  children       ContractProcessStep[] @relation("CPStepTree")
  process        ContractProcess       @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([parentId])
}

model ContractProcessTemplate {
  id          String                        @id @default(cuid())
  name        String
  type        String
  description String                        @default("")
  isDefault   Boolean                       @default(false)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  steps       ContractProcessTemplateStep[]
}

model ContractProcessTemplateStep {
  id             String                        @id @default(cuid())
  templateId     String
  parentId       String?
  wbs            String                        @default("")
  name           String
  department     String                        @default("")
  duration       Int                           @default(1)
  sortOrder      Int                           @default(0)
  level          Int                           @default(0)
  isPaymentStep  Boolean                       @default(false)
  paymentPercent Float                         @default(0)
  color          String                        @default("")
  parent         ContractProcessTemplateStep?  @relation("CPTplStepTree", fields: [parentId], references: [id])
  children       ContractProcessTemplateStep[] @relation("CPTplStepTree")
  template       ContractProcessTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([parentId])
}
