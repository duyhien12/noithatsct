generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  role         String   @default("ky_thuat")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  department   String   @default("")
  phone        String   @default("")
  zaloUserId   String   @default("")
  allowedRoles String   @default("[]")
}

model Customer {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  phone             String
  email             String            @default("")
  address           String            @default("")
  type              String            @default("Cá nhân")
  status            String            @default("Lead")
  taxCode           String            @default("")
  representative    String            @default("")
  birthday          DateTime?
  source            String            @default("")
  notes             String            @default("")
  totalRevenue      Float             @default(0)
  gender            String            @default("Nam")
  projectAddress    String            @default("")
  projectName       String            @default("")
  salesPerson       String            @default("")
  designer          String            @default("")
  contactPerson2    String            @default("")
  phone2            String            @default("")
  pipelineStage     String            @default("Lead")
  estimatedValue    Float             @default(0)
  nextFollowUp      DateTime?
  score             Int               @default(0)
  lastContactAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdByRole     String            @default("")
  processData       String            @default("")
  branch            String            @default("HQ")
  contracts         Contract[]
  contractProcesses ContractProcess[]
  projects          Project[]
  documents         ProjectDocument[]
  quotations        Quotation[]
  trackingLogs      TrackingLog[]
}

model Project {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  name               String
  type               String
  address            String                 @default("")
  description        String                 @default("")
  area               Float                  @default(0)
  floors             Int                    @default(0)
  budget             Float                  @default(0)
  spent              Float                  @default(0)
  contractValue      Float                  @default(0)
  paidAmount         Float                  @default(0)
  status             String                 @default("Khảo sát")
  phase              String                 @default("")
  progress           Int                    @default(0)
  startDate          DateTime?
  endDate            DateTime?
  manager            String                 @default("")
  designer           String                 @default("")
  supervisor         String                 @default("")
  notes              String                 @default("")
  budgetStatus       String                 @default("draft")
  budgetLockedAt     DateTime?
  budgetLockedBy     String                 @default("")
  budgetTotal        Float                  @default(0)
  customerId         String
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  budgetEstimateData Json?
  createdByRole      String                 @default("")
  frontPhotos        Json?
  latitude           Float?
  longitude          Float?
  routeNotes         String                 @default("")
  siteContact        String                 @default("")
  siteContactPhone   String                 @default("")
  changeOrders       BudgetChangeOrder[]
  commitments        Commitment[]
  contracts          Contract[]
  contractorPays     ContractorPayment[]
  documentFolders    DocumentFolder[]
  inventoryTx        InventoryTransaction[]
  journalEntries     JournalEntry[]
  maintenanceRecords MaintenanceRecord[]
  materialPlans      MaterialPlan[]
  requisitions       MaterialRequisition[]
  productionCosts    ProductionCostItem[]
  productionOrders   ProductionOrder?
  productionPlan     ProductionPlan?
  progressReports    ProgressReport[]
  customer           Customer               @relation(fields: [customerId], references: [id])
  budgets            ProjectBudget[]
  projectChats       ProjectChatMsg[]
  checkIns           ProjectCheckIn[]
  documents          ProjectDocument[]
  employees          ProjectEmployee[]
  expenses           ProjectExpense[]
  milestones         ProjectMilestone[]
  purchaseOrders     PurchaseOrder[]
  quotations         Quotation[]
  salaryProgress     SalaryProgress?
  scheduleTasks      ScheduleTask[]
  trackingLogs       TrackingLog[]
  transactions       Transaction[]
  workLogEntries     WorkLogEntry[]
  workOrders         WorkOrder[]
  workshopTasks      WorkshopTask[]

  @@index([customerId])
}

model ProductCategory {
  id        String            @id @default(cuid())
  name      String
  slug      String            @default("")
  order     Int               @default(0)
  parentId  String?
  createdAt DateTime          @default(now())
  supplier  String            @default("")
  products  Product[]
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")

  @@index([parentId])
}

model Product {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  category          String
  unit              String
  importPrice       Float                  @default(0)
  salePrice         Float                  @default(0)
  stock             Int                    @default(0)
  minStock          Int                    @default(0)
  supplier          String                 @default("")
  description       String                 @default("")
  dimensions        String                 @default("")
  weight            Float                  @default(0)
  color             String                 @default("")
  material          String                 @default("")
  origin            String                 @default("")
  warranty          String                 @default("")
  brand             String                 @default("")
  status            String                 @default("Đang bán")
  supplyType        String                 @default("Vật tư lưu kho")
  leadTimeDays      Int                    @default(0)
  location          String                 @default("")
  image             String                 @default("")
  coreBoard         String                 @default("")
  surfaceCode       String                 @default("")
  categoryId        String?
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  inventoryTx       InventoryTransaction[]
  materialPlans     MaterialPlan[]
  categoryRef       ProductCategory?       @relation(fields: [categoryId], references: [id])
  attributes        ProductAttribute[]
  bomUsedIn         ProductBOM[]           @relation("BOMComponent")
  bomComponents     ProductBOM[]           @relation("BOMParent")
  purchaseItems     PurchaseOrderItem[]
  quotationItems    QuotationItem[]
  workshopMaterials WorkshopTaskMaterial[]

  @@index([categoryId])
}

model Quotation {
  id                String              @id @default(cuid())
  code              String              @unique
  total             Float               @default(0)
  discount          Float               @default(0)
  vat               Float               @default(10)
  grandTotal        Float               @default(0)
  status            String              @default("Nháp")
  validUntil        DateTime?
  notes             String              @default("")
  type              String              @default("Thi công")
  directCost        Float               @default(0)
  managementFeeRate Float               @default(5)
  managementFee     Float               @default(0)
  designFee         Float               @default(0)
  otherFee          Float               @default(0)
  adjustment        Float               @default(0)
  adjustmentType    String              @default("amount")
  adjustmentAmount  Float               @default(0)
  deductions        Json?               @default("[]")
  revision          Int                 @default(1)
  parentId          String?
  lockedAt          DateTime?
  customerId        String
  projectId         String?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  paymentSchedule   Json?               @default("[]")
  promoText         String              @default("")
  terms             String              @default("")
  attachments       Json?               @default("[]")
  contracts         Contract[]
  customer          Customer            @relation(fields: [customerId], references: [id])
  parent            Quotation?          @relation("QuotationRevisions", fields: [parentId], references: [id])
  children          Quotation[]         @relation("QuotationRevisions")
  project           Project?            @relation(fields: [projectId], references: [id])
  categories        QuotationCategory[]
  items             QuotationItem[]

  @@index([customerId])
  @@index([projectId])
  @@index([parentId])
}

model QuotationCategory {
  id              String          @id @default(cuid())
  name            String
  group           String          @default("")
  image           String          @default("")
  order           Int             @default(0)
  subtotal        Float           @default(0)
  quotationId     String
  sharedUnit      String          @default("trọn gói")
  sharedQuantity  Float           @default(1)
  sharedUnitPrice Float           @default(0)
  quotation       Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  items           QuotationItem[]

  @@index([quotationId])
}

model QuotationItem {
  id             String             @id @default(cuid())
  name           String
  order          Int                @default(0)
  unit           String             @default("")
  quantity       Float              @default(0)
  volume         Float              @default(0)
  mainMaterial   Float              @default(0)
  auxMaterial    Float              @default(0)
  labor          Float              @default(0)
  unitPrice      Float              @default(0)
  amount         Float              @default(0)
  description    String             @default("")
  length         Float              @default(0)
  width          Float              @default(0)
  height         Float              @default(0)
  image          String             @default("")
  productId      String?
  parentItemId   String?
  quotationId    String
  categoryId     String?
  mergedWithPrev Boolean            @default(false)
  category       QuotationCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentItem     QuotationItem?     @relation("SubItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  subItems       QuotationItem[]    @relation("SubItems")
  product        Product?           @relation(fields: [productId], references: [id])
  quotation      Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([parentItemId])
}

model Warehouse {
  id          String                 @id @default(cuid())
  code        String                 @unique
  name        String
  address     String                 @default("")
  createdAt   DateTime               @default(now())
  inventoryTx InventoryTransaction[]
}

model InventoryTransaction {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String
  quantity    Float
  unit        String    @default("")
  note        String    @default("")
  date        DateTime  @default(now())
  productId   String
  warehouseId String
  projectId   String?
  createdAt   DateTime  @default(now())
  images      String    @default("[]")
  product     Product   @relation(fields: [productId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([projectId])
}

model Transaction {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  description String
  amount      Float
  category    String   @default("")
  date        DateTime @default(now())
  projectId   String?
  createdAt   DateTime @default(now())
  project     Project? @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
}

model Employee {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  position     String            @default("")
  phone        String            @default("")
  email        String            @default("")
  salary       Float             @default(0)
  status       String            @default("Đang làm")
  joinDate     DateTime?
  departmentId String
  deletedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  birthDate    DateTime?
  department   Department        @relation(fields: [departmentId], references: [id])
  projects     ProjectEmployee[]
}

model ProjectEmployee {
  projectId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])

  @@id([projectId, employeeId])
}

model Contractor {
  id            String              @id @default(cuid())
  code          String              @unique
  name          String
  type          String
  phone         String              @default("")
  address       String              @default("")
  taxCode       String              @default("")
  bankAccount   String              @default("")
  bankName      String              @default("")
  rating        Int                 @default(3)
  notes         String              @default("")
  isBlacklisted Boolean             @default(false)
  creditLimit   Float               @default(0)
  category      String              @default("")
  advanceAmount Float               @default(0)
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  payments      ContractorPayment[]
  documents     ProjectDocument[]
}

model ContractorPayment {
  id                String                  @id @default(cuid())
  contractAmount    Float                   @default(0)
  paidAmount        Float                   @default(0)
  netAmount         Float                   @default(0)
  status            String                  @default("pending_technical")
  phase             String                  @default("")
  description       String                  @default("")
  dueDate           DateTime?
  approvedBy        String                  @default("")
  approvedAt        DateTime?
  attachments       Json?
  retentionRate     Float                   @default(5)
  retentionAmount   Float                   @default(0)
  retentionReleased Boolean                 @default(false)
  contractorId      String
  projectId         String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  contractor        Contractor              @relation(fields: [contractorId], references: [id])
  project           Project                 @relation(fields: [projectId], references: [id])
  items             ContractorPaymentItem[]

  @@index([projectId])
  @@index([contractorId])
}

model ContractorPaymentItem {
  id                  String            @id @default(cuid())
  description         String
  unit                String            @default("")
  quantity            Float             @default(0)
  unitPrice           Float             @default(0)
  amount              Float             @default(0)
  notes               String            @default("")
  acceptedAt          DateTime          @default(now())
  contractorPaymentId String
  contractorPayment   ContractorPayment @relation(fields: [contractorPaymentId], references: [id], onDelete: Cascade)

  @@index([contractorPaymentId])
}

model Supplier {
  id             String            @id @default(cuid())
  code           String            @unique
  name           String
  type           String            @default("Vật tư xây dựng")
  contact        String            @default("")
  phone          String            @default("")
  email          String            @default("")
  address        String            @default("")
  taxCode        String            @default("")
  bankAccount    String            @default("")
  bankName       String            @default("")
  rating         Int               @default(3)
  notes          String            @default("")
  isBlacklisted  Boolean           @default(false)
  creditLimit    Float             @default(0)
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  documents      ProjectDocument[]
  purchaseOrders PurchaseOrder[]
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  name      String
  progress  Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("Chưa bắt đầu")
  order     Int       @default(0)
  projectId String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model ProjectBudget {
  id           String  @id @default(cuid())
  category     String
  budgetAmount Float   @default(0)
  actualAmount Float   @default(0)
  notes        String  @default("")
  projectId    String
  project      Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model Contract {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  type              String            @default("Thi công")
  contractValue     Float             @default(0)
  paidAmount        Float             @default(0)
  variationAmount   Float             @default(0)
  status            String            @default("Nháp")
  signDate          DateTime?
  startDate         DateTime?
  endDate           DateTime?
  paymentTerms      String            @default("")
  notes             String            @default("")
  fileUrl           String            @default("")
  customerId        String
  projectId         String
  quotationId       String?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  customer          Customer          @relation(fields: [customerId], references: [id])
  project           Project           @relation(fields: [projectId], references: [id])
  quotation         Quotation?        @relation(fields: [quotationId], references: [id])
  payments          ContractPayment[]
  contractProcesses ContractProcess[]

  @@index([projectId])
  @@index([customerId])
}

model ContractPayment {
  id         String    @id @default(cuid())
  phase      String
  amount     Float     @default(0)
  paidAmount Float     @default(0)
  category   String    @default("Hợp đồng")
  status     String    @default("Chưa thu")
  dueDate    DateTime?
  paidDate   DateTime?
  notes      String    @default("")
  proofUrl   String    @default("")
  contractId String
  createdAt  DateTime  @default(now())
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model WorkOrder {
  id          String              @id @default(cuid())
  code        String              @unique
  title       String
  description String              @default("")
  priority    String              @default("Trung bình")
  status      String              @default("Chờ xử lý")
  assignee    String              @default("")
  dueDate     DateTime?
  completedAt DateTime?
  category    String              @default("")
  projectId   String
  deletedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sourceLogId String?
  project     Project             @relation(fields: [projectId], references: [id])
  checkins    WorkOrderCheckin[]
  photos      WorkOrderPhoto[]
  qcItems     WorkOrderQCItem[]
  stageLogs   WorkOrderStageLog[]

  @@index([projectId])
  @@index([sourceLogId])
}

model WorkOrderCheckin {
  id          String    @id @default(cuid())
  workOrderId String
  workerName  String
  checkinAt   DateTime  @default(now())
  checkoutAt  DateTime?
  notes       String    @default("")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model WorkOrderPhoto {
  id          String    @id @default(cuid())
  workOrderId String
  url         String
  caption     String    @default("")
  type        String    @default("evidence")
  uploadedBy  String    @default("")
  createdAt   DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model WorkOrderQCItem {
  id          String    @id @default(cuid())
  workOrderId String
  item        String
  status      String    @default("pending")
  note        String    @default("")
  checkedBy   String    @default("")
  checkedAt   DateTime?
  sortOrder   Int       @default(0)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model WorkOrderStageLog {
  id          String    @id @default(cuid())
  workOrderId String
  fromStatus  String
  toStatus    String
  changedBy   String    @default("")
  note        String    @default("")
  createdAt   DateTime  @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model MaterialPlan {
  id              String                @id @default(cuid())
  quantity        Float                 @default(0)
  orderedQty      Float                 @default(0)
  receivedQty     Float                 @default(0)
  unitPrice       Float                 @default(0)
  totalAmount     Float                 @default(0)
  status          String                @default("Chưa đặt")
  type            String                @default("Chính")
  category        String                @default("")
  budgetUnitPrice Float                 @default(0)
  wastePercent    Float                 @default(5)
  isLocked        Boolean               @default(false)
  notes           String                @default("")
  costType        String                @default("Vật tư")
  group1          String                @default("")
  group2          String                @default("")
  drawingUrl      String                @default("")
  drawingNote     String                @default("")
  supplierTag     String                @default("")
  productId       String?
  projectId       String
  createdAt       DateTime              @default(now())
  actualCost      Float                 @default(0)
  planType        String                @default("tracking")
  customName      String                @default("")
  salePrice       Float                 @default(0)
  unit            String                @default("")
  actualQty       Float                 @default(0)
  product         Product?              @relation(fields: [productId], references: [id])
  project         Project               @relation(fields: [projectId], references: [id])
  requisitions    MaterialRequisition[]
  purchaseItems   PurchaseOrderItem[]

  @@index([projectId])
  @@index([productId])
}

model ProductionCostItem {
  id               String   @id @default(cuid())
  projectId        String
  groupName        String   @default("")
  groupOrder       Int      @default(0)
  sortOrder        Int      @default(0)
  name             String   @default("")
  productCode      String   @default("")
  spec             String   @default("")
  unit             String   @default("")
  quantity         Float    @default(0)
  dimLength        Float    @default(0)
  dimWidth         Float    @default(0)
  dimHeight        Float    @default(0)
  dimTotal         Float    @default(0)
  unitPrice        Float    @default(0)
  productionAmount Float    @default(0)
  salePrice        Float    @default(0)
  createdAt        DateTime @default(now())
  autoPercent      Float    @default(0)
  project          Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model BudgetChangeOrder {
  id             String   @id @default(cuid())
  projectId      String
  materialPlanId String?
  reason         String
  oldQty         Float    @default(0)
  newQty         Float    @default(0)
  oldPrice       Float    @default(0)
  newPrice       Float    @default(0)
  status         String   @default("pending")
  requestedBy    String   @default("")
  approvedBy     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model MaterialRequisition {
  id              String         @id @default(cuid())
  code            String         @unique
  requestedQty    Float          @default(0)
  requestedDate   DateTime?
  notes           String         @default("")
  status          String         @default("Chờ xử lý")
  createdBy       String         @default("")
  materialPlanId  String
  projectId       String
  purchaseOrderId String?
  createdAt       DateTime       @default(now())
  materialPlan    MaterialPlan   @relation(fields: [materialPlanId], references: [id])
  project         Project        @relation(fields: [projectId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([projectId])
  @@index([materialPlanId])
}

model PurchaseOrder {
  id              String                @id @default(cuid())
  code            String                @unique
  supplier        String
  totalAmount     Float                 @default(0)
  paidAmount      Float                 @default(0)
  status          String                @default("Chờ duyệt")
  deliveryType    String                @default("Giao thẳng dự án")
  deliveryAddress String                @default("")
  orderDate       DateTime              @default(now())
  deliveryDate    DateTime?
  receivedDate    DateTime?
  notes           String                @default("")
  projectId       String?
  supplierId      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdByRole   String                @default("")
  requisitions    MaterialRequisition[]
  project         Project?              @relation(fields: [projectId], references: [id])
  supplierRel     Supplier?             @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@index([projectId])
  @@index([supplierId])
  @@index([createdByRole])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  productName     String
  unit            String        @default("")
  quantity        Float         @default(0)
  unitPrice       Float         @default(0)
  amount          Float         @default(0)
  receivedQty     Float         @default(0)
  notes           String        @default("")
  productId       String?
  materialPlanId  String?
  purchaseOrderId String
  materialPlan    MaterialPlan? @relation(fields: [materialPlanId], references: [id])
  product         Product?      @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([materialPlanId])
}

model ProjectExpense {
  id            String    @id @default(cuid())
  code          String    @unique
  expenseType   String    @default("Dự án")
  description   String
  amount        Float     @default(0)
  paidAmount    Float     @default(0)
  category      String    @default("Khác")
  status        String    @default("Chờ duyệt")
  submittedBy   String    @default("")
  approvedBy    String    @default("")
  proofUrl      String    @default("")
  recipientType String    @default("")
  recipientId   String    @default("")
  recipientName String    @default("")
  date          DateTime  @default(now())
  notes         String    @default("")
  projectId     String?
